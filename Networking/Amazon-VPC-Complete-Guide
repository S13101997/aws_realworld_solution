## Network Security

### 1. Security Groups (Stateful)

```bash
# Create security group
SG=$(aws ec2 create-security-group \
  --group-name app-sg \
  --description "Security group for application" \
  --vpc-id $VPC \
  --query 'GroupId' \
  --output text)

# Allow inbound traffic (HTTP from anywhere)
aws ec2 authorize-security-group-ingress \
  --group-id $SG \
  --protocol tcp \
  --port 80 \
  --cidr 0.0.0.0/0

# Allow inbound SSH from specific CIDR
aws ec2 authorize-security-group-ingress \
  --group-id $SG \
  --protocol tcp \
  --port 22 \
  --cidr 203.0.113.0/24

# Allow inbound from another security group
aws ec2 authorize-security-group-ingress \
  --group-id $SG \
  --protocol tcp \
  --port 443 \
  --source-group $LOAD_BALANCER_SG

# Outbound: Allow all by default
# (can restrict if needed)

# Stateful: Response traffic automatically allowed
# If you allow outbound HTTP, inbound HTTP response is automatic
```

### 2. NACLs (Network ACLs - Stateless)

```bash
# Create NACL
NACL=$(aws ec2 create-network-acl \
  --vpc-id $VPC \
  --tag-specifications "ResourceType=network-acl,Tags=[{Key=Name,Value=app-nacl}]" \
  --query 'NetworkAcl.NetworkAclId' \
  --output text)

# Inbound rules (must be numbered)
# Rule 100: Allow HTTP from anywhere
aws ec2 create-network-acl-entry \
  --network-acl-id $NACL \
  --rule-number 100 \
  --protocol tcp \
  --port-range From=80,To=80 \
  --cidr-block 0.0.0.0/0 \
  --ingress

# Rule 110: Allow HTTPS from anywhere
aws ec2 create-network-acl-entry \
  --network-acl-id $NACL \
  --rule-number 110 \
  --protocol tcp \
  --port-range From=443,To=443 \
  --cidr-block 0.0.0.0/0 \
  --ingress

# Rule 120: Allow SSH from corporate network
aws ec2 create-network-acl-entry \
  --network-acl-id $NACL \
  --rule-number 120 \
  --protocol tcp \
  --port-range From=22,To=22 \
  --cidr-block 203.0.113.0/24 \
  --ingress

# Rule 130: Deny all other inbound
aws ec2 create-network-acl-entry \
  --network-acl-id $NACL \
  --rule-number 130 \
  --protocol -1 \
  --cidr-block 0.0.0.0/0 \
  --ingress

# Outbound rules
# Rule 100: Allow all outbound (ephemeral ports)
aws ec2 create-network-acl-entry \
  --network-acl-id $NACL \
  --rule-number 100 \
  --protocol -1 \
  --cidr-block 0.0.0.0/0 \
  --egress

# Associate with subnet
aws ec2 associate-network-acl \
  --network-acl-id $NACL \
  --subnet-id $PUBLIC_SUBNET
```

