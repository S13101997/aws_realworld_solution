## 8. Step-by-Step Examples

### Example 1: Multi-Region Failover

```bash
#!/bin/bash
set -e

ZONE_ID="Z1234567890ABC"

echo "=== Creating Health Checks ==="

# Health check for US East
HC_US=$(aws route53 create-health-check \
  --health-check-config \
    IPAddress=203.0.113.1 \
    Port=443 \
    Type=HTTPS \
    ResourcePath=/health \
    FullyQualifiedDomainName=us-east.example.com \
    RequestInterval=30 \
    FailureThreshold=3 \
  --query 'HealthCheck.Id' \
  --output text)
echo "US East Health Check: $HC_US"

# Health check for EU West
HC_EU=$(aws route53 create-health-check \
  --health-check-config \
    IPAddress=203.0.113.2 \
    Port=443 \
    Type=HTTPS \
    ResourcePath=/health \
    FullyQualifiedDomainName=eu-west.example.com \
    RequestInterval=30 \
    FailureThreshold=3 \
  --query 'HealthCheck.Id' \
  --output text)
echo "EU West Health Check: $HC_EU"

echo "=== Creating Failover Records ==="

# Primary: US East
aws route53 change-resource-record-sets \
  --hosted-zone-id $ZONE_ID \
  --change-batch '{
    "Changes": [{
      "Action": "CREATE",
      "ResourceRecordSet": {
        "Name": "api.example.com",
        "Type": "A",
        "SetIdentifier": "US-East-Primary",
        "Failover": "PRIMARY",
        "TTL": 60,
        "ResourceRecords": [{"Value": "203.0.113.1"}],
        "HealthCheckId": "'$HC_US'"
      }
    }]
  }'
echo "Created Primary record (US East)"

# Secondary: EU West
aws route53 change-resource-record-sets \
  --hosted-zone-id $ZONE_ID \
  --change-batch '{
    "Changes": [{
      "Action": "CREATE",
      "ResourceRecordSet": {
        "Name": "api.example.com",
        "Type": "A",
        "SetIdentifier": "EU-West-Secondary",
        "Failover": "SECONDARY",
        "TTL": 60,
        "ResourceRecords": [{"Value": "203.0.113.2"}]
      }
    }]
  }'
echo "Created Secondary record (EU West)"

echo "=== Failover Configuration Complete ==="
echo "api.example.com will:"
echo "  - Route to US East (203.0.113.1) when healthy"
echo "  - Failover to EU West (203.0.113.2) if US East unhealthy"
echo "  - Health check every 30 seconds"
echo "  - Failover triggered after 3 failures (90 seconds)"
```

