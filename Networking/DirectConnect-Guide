## 8. Step-by-Step Examples

### Example 1: Setup Single Direct Connect Connection

```bash
#!/bin/bash
set -e

# Configuration
LOCATION="Equinix SV1 (San Jose)"
BANDWIDTH="10Gbps"
CUSTOMER_ASN="65000"
REGION="us-west-1"
VPC_ID="vpc-12345678"
VGW_ID="vgw-87654321"

echo "=== Step 1: Create Direct Connect Connection ==="
CONNECTION=$(aws directconnect create-connection \
  --location "$LOCATION" \
  --bandwidth "$BANDWIDTH" \
  --connection-name "prod-dx-primary" \
  --region $REGION \
  --query 'connection.connectionId' \
  --output text)

echo "Connection ID: $CONNECTION"
echo "Status: Awaiting carrier approval (2-4 weeks)"
echo ""

echo "=== Step 2: Get Letter of Authorization ==="
aws directconnect describe-connection-loa \
  --connection-id $CONNECTION \
  --region $REGION

echo "Instructions:"
echo "1. Download LOA document"
echo "2. Contact carrier/colocation provider"
echo "3. Request cross-connect cable installation"
echo "4. Provide AWS LOA as reference"
echo ""

echo "=== Step 3: Wait for Connection Available ==="
echo "Checking connection status..."

# Poll until connection is available (simplified)
for i in {1..60}; do
  STATUS=$(aws directconnect describe-connections \
    --connection-ids $CONNECTION \
    --region $REGION \
    --query 'connections[0].connectionState' \
    --output text)
  
  if [ "$STATUS" = "available" ]; then
    echo "Connection is available!"
    break
  fi
  
  echo "Status: $STATUS (attempt $i/60)"
  sleep 30
done

echo ""
echo "=== Step 4: Create Private Virtual Interface ==="

VIF=$(aws directconnect create-private-virtual-interface \
  --connection-id $CONNECTION \
  --new-private-virtual-interface '{
    "virtualInterfaceName": "prod-vif-primary",
    "vlan": 100,
    "asn": '$CUSTOMER_ASN',
    "amazonAddress": "203.0.113.1/30",
    "customerAddress": "203.0.113.2/30",
    "addressFamily": "ipv4",
    "virtualGatewayId": "'$VGW_ID'",
    "tags": [{"key": "Environment", "value": "Production"}]
  }' \
  --region $REGION \
  --query 'virtualInterface.virtualInterfaceId' \
  --output text)

echo "VIF ID: $VIF"
echo ""

echo "=== Step 5: Configure BGP on Your Router ==="
cat << 'EOF'
Router Configuration Example:

router bgp 65000
  neighbor 203.0.113.1 remote-as 16509
  neighbor 203.0.113.1 description AWS-DX-PRIMARY
  !
  address-family ipv4
    neighbor 203.0.113.1 activate
    neighbor 203.0.113.1 soft-reconfiguration inbound
    !
    network 10.0.0.0 mask 255.0.0.0
  exit-address-family
!
interface eth0
  ip address 203.0.113.2 255.255.255.252
  description Direct-Connect-Primary
  no shutdown
EOF

echo ""
echo "=== Setup Complete ==="
echo "Direct Connect ID: $CONNECTION"
echo "Virtual Interface ID: $VIF"
echo "Status: Pending BGP session establishment"
echo "Next: Bring up BGP peer on your router"
```

### Example 2: Setup LAG for High Availability

```bash
#!/bin/bash
set -e

LOCATION="Equinix SV1 (San Jose)"
BANDWIDTH="10Gbps"
CUSTOMER_ASN="65000"
REGION="us-west-1"
VGW_ID="vgw-87654321"

echo "=== Creating Redundant Direct Connect LAG ==="

# Create LAG
echo "Creating LAG..."
LAG=$(aws directconnect create-lag \
  --location "$LOCATION" \
  --number-of-connections 2 \
  --connections-bandwidth "$BANDWIDTH" \
  --lag-name "prod-dx-lag-ha" \
  --minimum-links 2 \
  --region $REGION \
  --query 'lag.lagId' \
  --output text)

echo "LAG ID: $LAG"
echo "Minimum Links: 2 (requires at least 2 connections for traffic)"
echo ""

echo "=== Get LOA for Both Connections ==="
# After creating LAG, get LOAs for each connection
aws directconnect describe-lag \
  --lag-id $LAG \
  --region $REGION \
  --query 'lag.connections' \
  --output table

echo "For each connection, download LOA and provision cross-connect"
echo ""

echo "=== Create Private VIF on LAG ==="
# Create single VIF on LAG (spans both connections)
VIF=$(aws directconnect create-private-virtual-interface \
  --lag-id $LAG \
  --new-private-virtual-interface '{
    "virtualInterfaceName": "prod-vif-lag",
    "vlan": 100,
    "asn": '$CUSTOMER_ASN',
    "amazonAddress": "203.0.113.1/30",
    "customerAddress": "203.0.113.2/30",
    "addressFamily": "ipv4",
    "virtualGatewayId": "'$VGW_ID'",
    "tags": [{"key": "Environment", "value": "Production"}]
  }' \
  --region $REGION \
  --query 'virtualInterface.virtualInterfaceId' \
  --output text)

echo "VIF ID: $VIF"
echo ""

echo "=== Summary ==="
echo "LAG ID: $LAG"
echo "Bandwidth: 20 Gbps (10 Gbps × 2 connections)"
echo "Minimum Links: 2 (requires both connections for traffic)"
echo "Failover: If one connection fails, traffic continues via other"
echo "Configuration:"
echo "  - Both connections must reach 'available' state"
echo "  - Both cross-connects must be provisioned"
echo "  - BGP will establish on LAG once available"
```

