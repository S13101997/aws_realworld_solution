router bgp 65000
  neighbor 203.0.113.1 password YOUR-STRONG-PASSWORD
  
# 2. Enable MACsec encryption
aws directconnect associate-mac-sec-key \
  --connection-id dxcon-12345678 \
  --mac-sec-key <strong-key>

# 3. Restrict BGP prefix announcements
route-map FILTER-OUTBOUND
  match ip address prefix-list ALLOWED-ROUTES
  
# 4. Monitor unauthorized route announcements
aws directconnect describe-route-filters \
  --query 'routeFilters[*]'

# 5. Use VPC security groups and NACLs
# - Restrict traffic to specific ports
# - Implement zero-trust architecture
# - Use VPC Flow Logs for monitoring
