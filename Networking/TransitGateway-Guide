### Example 3: Multi-Region Setup

```bash
#!/bin/bash
set -e

echo "=== Step 1: Create Transit Gateways in Each Region ==="

# US-East Transit Gateway
TGW_US=$(aws ec2 create-transit-gateway \
  --description "US-East Transit Gateway" \
  --region us-east-1 \
  --query 'TransitGateway.TransitGatewayId' \
  --output text)

echo "US-East TGW: $TGW_US"

# EU-West Transit Gateway
TGW_EU=$(aws ec2 create-transit-gateway \
  --description "EU-West Transit Gateway" \
  --region eu-west-1 \
  --query 'TransitGateway.TransitGatewayId' \
  --output text)

echo "EU-West TGW: $TGW_EU"

echo ""
echo "=== Step 2: Create Transit Gateway Peering ==="

# Create peering attachment
PEERING=$(aws ec2 create-transit-gateway-peering-attachment \
  --transit-gateway-id $TGW_US \
  --peer-transit-gateway-id $TGW_EU \
  --peer-account-id 123456789012 \
  --peer-region eu-west-1 \
  --region us-east-1 \
  --query 'TransitGatewayPeeringAttachment.TransitGatewayAttachmentId' \
  --output text)

echo "Peering Attachment: $PEERING"

# Accept in EU-West
echo "Accepting peering in EU-West..."
aws ec2 accept-transit-gateway-peering-attachment \
  --transit-gateway-attachment-id $PEERING \
  --region eu-west-1

echo "✓ Peering accepted"

echo ""
echo "=== Step 3: Configure Routes for Multi-Region ==="

# Get default route tables
RT_US=$(aws ec2 describe-transit-gateway-route-tables \
  --filters "Name=transit-gateway-id,Values=$TGW_US" \
  --region us-east-1 \
  --query 'TransitGatewayRouteTables[0].TransitGatewayRouteTableId' \
  --output text)

RT_EU=$(aws ec2 describe-transit-gateway-route-tables \
  --filters "Name=transit-gateway-id,Values=$TGW_EU" \
  --region eu-west-1 \
  --query 'TransitGatewayRouteTables[0].TransitGatewayRouteTableId' \
  --output text)

# US route to EU networks
aws ec2 create-transit-gateway-route \
  --transit-gateway-route-table-id $RT_US \
  --destination-cidr-block 10.100.0.0/16 \
  --transit-gateway-attachment-id $PEERING \
  --region us-east-1

# EU route to US networks
aws ec2 create-transit-gateway-route \
  --transit-gateway-route-table-id $RT_EU \
  --destination-cidr-block 10.0.0.0/16 \
  --transit-gateway-attachment-id $PEERING \
  --region eu-west-1

echo "✓ Multi-region routes configured"

echo ""
echo "=== Multi-Region Setup Complete ==="
echo "Architecture:"
echo "  US-East: $TGW_US (VPCs in us-east-1)"
echo "  EU-West: $TGW_EU (VPCs in eu-west-1)"
echo "  Peering: Connected via $PEERING"
echo "  Result: VPCs in both regions can communicate"
```

