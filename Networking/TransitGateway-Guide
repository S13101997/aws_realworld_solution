## 8. Step-by-Step Examples

### Example 1: Setup Basic Hub-and-Spoke

```bash
#!/bin/bash
set -e

echo "=== Step 1: Create Transit Gateway ==="
TGW=$(aws ec2 create-transit-gateway \
  --description "Hub-and-Spoke Transit Gateway" \
  --options "AmazonSideAsn=64512,DefaultRouteTableAssociation=enable,DefaultRouteTablePropagation=enable,DnsSupport=enable,VpnEcnSupport=enable" \
  --query 'TransitGateway.TransitGatewayId' \
  --output text)

echo "Transit Gateway ID: $TGW"
echo "Status: Creating (wait 1-2 minutes)"
sleep 30

echo ""
echo "=== Step 2: Create VPC Attachments ==="

# VPC 1 (Production)
VPC1_ATTACH=$(aws ec2 create-transit-gateway-vpc-attachment \
  --transit-gateway-id $TGW \
  --vpc-id vpc-prod-001 \
  --subnet-ids subnet-prod-1a subnet-prod-1b \
  --query 'TransitGatewayVpcAttachment.TransitGatewayAttachmentId' \
  --output text)

echo "VPC-1 (Prod) Attachment: $VPC1_ATTACH"

# VPC 2 (Development)
VPC2_ATTACH=$(aws ec2 create-transit-gateway-vpc-attachment \
  --transit-gateway-id $TGW \
  --vpc-id vpc-dev-001 \
  --subnet-ids subnet-dev-1a subnet-dev-1b \
  --query 'TransitGatewayVpcAttachment.TransitGatewayAttachmentId' \
  --output text)

echo "VPC-2 (Dev) Attachment: $VPC2_ATTACH"

# VPC 3 (Shared Services)
VPC3_ATTACH=$(aws ec2 create-transit-gateway-vpc-attachment \
  --transit-gateway-id $TGW \
  --vpc-id vpc-shared-001 \
  --subnet-ids subnet-shared-1a subnet-shared-1b \
  --query 'TransitGatewayVpcAttachment.TransitGatewayAttachmentId' \
  --output text)

echo "VPC-3 (Shared) Attachment: $VPC3_ATTACH"

echo ""
echo "=== Step 3: Wait for Attachments ==="
for attach_id in $VPC1_ATTACH $VPC2_ATTACH $VPC3_ATTACH; do
  echo "Waiting for $attach_id..."
  aws ec2 wait transit-gateway-attachment-available \
    --filters "Name=transit-gateway-attachment-id,Values=$attach_id"
  echo "✓ $attach_id available"
done

echo ""
echo "=== Step 4: Update VPC Route Tables ==="

# Production VPC route table
aws ec2 create-route \
  --route-table-id rtb-prod \
  --destination-cidr-block 0.0.0.0/0 \
  --transit-gateway-id $TGW

# Development VPC route table
aws ec2 create-route \
  --route-table-id rtb-dev \
  --destination-cidr-block 0.0.0.0/0 \
  --transit-gateway-id $TGW

# Shared VPC route table
aws ec2 create-route \
  --route-table-id rtb-shared \
  --destination-cidr-block 0.0.0.0/0 \
  --transit-gateway-id $TGW

echo "✓ Routes created"

echo ""
echo "=== Setup Complete ==="
echo "Transit Gateway: $TGW"
echo "VPC Attachments: $VPC1_ATTACH, $VPC2_ATTACH, $VPC3_ATTACH"
echo "All VPCs can now communicate through the Transit Gateway"
```

### Example 2: Setup Segmented Network

```bash
#!/bin/bash
set -e

echo "=== Step 1: Create Segmented Route Tables ==="

TGW="tgw-12345678"

PROD_RT=$(aws ec2 create-transit-gateway-route-table \
  --transit-gateway-id $TGW \
  --tag-specifications 'ResourceType=transit-gateway-route-table,Tags=[{Key=Name,Value=prod-routes}]' \
  --query 'TransitGatewayRouteTable.TransitGatewayRouteTableId' \
  --output text)

DEV_RT=$(aws ec2 create-transit-gateway-route-table \
  --transit-gateway-id $TGW \
  --tag-specifications 'ResourceType=transit-gateway-route-table,Tags=[{Key=Name,Value=dev-routes}]' \
  --query 'TransitGatewayRouteTable.TransitGatewayRouteTableId' \
  --output text)

SHARED_RT=$(aws ec2 create-transit-gateway-route-table \
  --transit-gateway-id $TGW \
  --tag-specifications 'ResourceType=transit-gateway-route-table,Tags=[{Key=Name,Value=shared-routes}]' \
  --query 'TransitGatewayRouteTable.TransitGatewayRouteTableId' \
  --output text)

echo "Production RT: $PROD_RT"
echo "Development RT: $DEV_RT"
echo "Shared RT: $SHARED_RT"

echo ""
echo "=== Step 2: Associate Attachments to Route Tables ==="

# Get attachment IDs (from previous example)
VPC_PROD_ATTACH="tgw-attach-prod001"
VPC_DEV_ATTACH="tgw-attach-dev001"
VPC_SHARED_ATTACH="tgw-attach-shared001"
DX_ATTACH="tgw-attach-dx001"

# Associate production VPC to production route table
aws ec2 associate-transit-gateway-route-table \
  --transit-gateway-route-table-id $PROD_RT \
  --transit-gateway-attachment-id $VPC_PROD_ATTACH

# Associate dev VPC to dev route table
aws ec2 associate-transit-gateway-route-table \
  --transit-gateway-route-table-id $DEV_RT \
  --transit-gateway-attachment-id $VPC_DEV_ATTACH

# Associate shared VPC to shared route table
aws ec2 associate-transit-gateway-route-table \
  --transit-gateway-route-table-id $SHARED_RT \
  --transit-gateway-attachment-id $VPC_SHARED_ATTACH

echo "✓ Attachments associated"

echo ""
echo "=== Step 3: Create Routes ==="

# Production can access everything
aws ec2 create-transit-gateway-route \
  --transit-gateway-route-table-id $PROD_RT \
  --destination-cidr-block 10.10.0.0/16 \
  --transit-gateway-attachment-id $VPC_DEV_ATTACH

aws ec2 create-transit-gateway-route \
  --transit-gateway-route-table-id $PROD_RT \
  --destination-cidr-block 10.50.0.0/16 \
  --transit-gateway-attachment-id $VPC_SHARED_ATTACH

aws ec2 create-transit-gateway-route \
  --transit-gateway-route-table-id $PROD_RT \
  --destination-cidr-block 10.0.0.0/8 \
  --transit-gateway-attachment-id $DX_ATTACH

# Development can access shared services only (not production)
aws ec2 create-transit-gateway-route \
  --transit-gateway-route-table-id $DEV_RT \
