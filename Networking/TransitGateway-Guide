  --filters "Name=transit-gateway-attachment-id,Values=tgw-attach-12345678" \
  --query 'TransitGatewayAttachments[0].{State:State,ResourceId:ResourceId,SubnetIds:SubnetIds}' \
  --output json

# Possible states:
# - pending: Waiting for acceptance (normal for new attachments)
# - available: Ready to route traffic
# - modifying: Configuration change in progress
# - deleting: Attachment is being removed
# - deleted: Attachment removed
# - failed: Error during creation
# - failing: Error during operation
# - rejected: Manually rejected

# Troubleshooting failed attachment:
# 1. Check VPC exists and is accessible
# 2. Verify subnets are in correct VPC
# 3. Ensure sufficient capacity
# 4. Review CloudTrail logs for error details
