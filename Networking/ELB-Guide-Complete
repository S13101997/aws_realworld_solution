## 9. Step-by-Step Examples

### Example 1: Multi-Tier Application with ALB

```bash
#!/bin/bash
set -e

# Configuration
VPC_ID="vpc-12345678"
SUBNET_1A="subnet-12345678"
SUBNET_1B="subnet-87654321"
CERT_ARN="arn:aws:acm:us-east-1:123456789012:certificate/abc123"

echo "=== Creating ALB ==="
ALB=$(aws elbv2 create-load-balancer \
  --name three-tier-alb \
  --subnets $SUBNET_1A $SUBNET_1B \
  --security-groups sg-12345678 \
  --scheme internet-facing \
  --type application \
  --tags Key=Name,Value=three-tier-alb Key=Environment,Value=prod \
  --query 'LoadBalancers[0].LoadBalancerArn' \
  --output text)
echo "ALB Created: $ALB"

echo "=== Creating Target Groups ==="

# Web Tier Target Group
WEB_TG=$(aws elbv2 create-target-group \
  --name web-servers \
  --protocol HTTP \
  --port 80 \
  --vpc-id $VPC_ID \
  --target-type instance \
  --health-check-path / \
  --query 'TargetGroups[0].TargetGroupArn' \
  --output text)
echo "Web TG: $WEB_TG"

# API Tier Target Group
API_TG=$(aws elbv2 create-target-group \
  --name api-servers \
  --protocol HTTP \
  --port 8080 \
  --vpc-id $VPC_ID \
  --target-type instance \
  --health-check-path /health \
  --query 'TargetGroups[0].TargetGroupArn' \
  --output text)
echo "API TG: $API_TG"

echo "=== Registering Targets ==="
aws elbv2 register-targets --target-group-arn $WEB_TG --targets Id=i-web-1 Id=i-web-2 Id=i-web-3
aws elbv2 register-targets --target-group-arn $API_TG --targets Id=i-api-1 Id=i-api-2

echo "=== Creating HTTPS Listener ==="
LISTENER_HTTPS=$(aws elbv2 create-listener \
  --load-balancer-arn $ALB \
  --protocol HTTPS \
  --port 443 \
  --certificates CertificateArn=$CERT_ARN \
  --default-actions Type=forward,TargetGroupArn=$WEB_TG \
  --query 'Listeners[0].ListenerArn' \
  --output text)

echo "=== Creating HTTP Redirect ==="
aws elbv2 create-listener \
  --load-balancer-arn $ALB \
  --protocol HTTP \
  --port 80 \
  --default-actions Type=redirect,RedirectConfig={Protocol=HTTPS,Port=443,StatusCode=HTTP_301}

echo "=== Creating Rules ==="
aws elbv2 create-rule \
  --listener-arn $LISTENER_HTTPS \
  --priority 1 \
  --conditions Field=path-pattern,Values=/api/* \
  --actions Type=forward,TargetGroupArn=$API_TG

echo "Configuration Complete!"
DNS=$(aws elbv2 describe-load-balancers \
  --load-balancer-arns $ALB \
  --query 'LoadBalancers[0].DNSName' \
  --output text)
echo "ALB DNS: https://$DNS"
```

### Example 2: Auto Scaling with ALB

```bash
# Create Launch Template
LAUNCH_TEMPLATE=$(aws ec2 create-launch-template \
  --launch-template-name web-app-template \
  --launch-template-data '{
    "ImageId": "ami-0c55b159cbfafe1f0",
    "InstanceType": "t3.micro",
    "SecurityGroupIds": ["sg-12345678"]
  }' \
  --query 'LaunchTemplate.LaunchTemplateId' \
  --output text)

# Create Auto Scaling Group
