## Step-by-Step Examples

### Example 1: Create User Table and Add Items

#### Step 1: Create Table with On-Demand Billing

```bash
# Create Users table
aws dynamodb create-table \
  --table-name Users \
  --attribute-definitions \
    AttributeName=user_id,AttributeType=S \
    AttributeName=email,AttributeType=S \
  --key-schema \
    AttributeName=user_id,KeyType=HASH \
  --global-secondary-indexes \
    IndexName=EmailIndex,\
    Keys=[{AttributeName=email,KeyType=HASH}],\
    Projection={ProjectionType=ALL},\
    ProvisionedThroughput={ReadCapacityUnits=5,WriteCapacityUnits=5} \
  --billing-mode PAY_PER_REQUEST \
  --stream-specification StreamEnabled=true,StreamViewType=NEW_AND_OLD_IMAGES \
  --tags Key=Application,Value=UserApp Key=Environment,Value=Production

# Wait for table to be created
aws dynamodb wait table-exists --table-name Users
```

#### Step 2: Add Items to Table

```bash
# Add user item
aws dynamodb put-item \
  --table-name Users \
  --item '{
    "user_id": {"S": "user-123"},
    "name": {"S": "John Doe"},
    "email": {"S": "john@example.com"},
    "age": {"N": "30"},
    "is_active": {"BOOL": true},
    "tags": {"SS": ["vip", "premium"]},
    "created_at": {"S": "2025-11-25T10:30:00Z"},
    "address": {"M": {
      "street": {"S": "123 Main St"},
      "city": {"S": "New York"},
      "zip": {"S": "10001"}
    }}
  }'

# Add multiple items in batch
aws dynamodb batch-write-item \
  --request-items '{
    "Users": [
      {
        "PutRequest": {
          "Item": {
            "user_id": {"S": "user-124"},
            "name": {"S": "Jane Smith"},
            "email": {"S": "jane@example.com"},
            "age": {"N": "28"},
            "is_active": {"BOOL": true},
            "tags": {"SS": ["premium"]},
            "created_at": {"S": "2025-11-24T14:20:00Z"}
          }
        }
      },
      {
        "PutRequest": {
          "Item": {
            "user_id": {"S": "user-125"},
            "name": {"S": "Bob Johnson"},
            "email": {"S": "bob@example.com"},
            "age": {"N": "35"},
            "is_active": {"BOOL": false},
            "tags": {"SS": ["standard"]},
            "created_at": {"S": "2025-11-23T09:15:00Z"}
          }
        }
      }
    ]
  }'

echo "Items added to Users table"
```

#### Step 3: Query Items

```bash
# Get single item by primary key
aws dynamodb get-item \
  --table-name Users \
  --key '{"user_id":{"S":"user-123"}}'

# Query using GSI by email
aws dynamodb query \
  --table-name Users \
  --index-name EmailIndex \
  --key-condition-expression "email = :email" \
  --expression-attribute-values '{":email":{"S":"john@example.com"}}'

# Scan table with filter
aws dynamodb scan \
  --table-name Users \
  --filter-expression "age > :min_age AND is_active = :active" \
  --expression-attribute-values '{
    ":min_age":{"N":"25"},
    ":active":{"BOOL":true}
  }'
```

#### Step 4: Update Item

```bash
# Update single attribute
aws dynamodb update-item \
  --table-name Users \
  --key '{"user_id":{"S":"user-123"}}' \
  --update-expression "SET age = :age, #updated = :updated" \
  --expression-attribute-names '{"#updated":"updated_at"}' \
  --expression-attribute-values '{
    ":age":{"N":"31"},
    ":updated":{"S":"2025-11-25T15:45:00Z"}
  }' \
  --return-values ALL_NEW

# Add element to set
aws dynamodb update-item \
  --table-name Users \
  --key '{"user_id":{"S":"user-123"}}' \
  --update-expression "ADD tags :tag" \
  --expression-attribute-values '{":tag":{"SS":["gold-member"]}}'

# Increment counter
aws dynamodb update-item \
  --table-name Users \
  --key '{"user_id":{"S":"user-123"}}' \
  --update-expression "ADD login_count :inc" \
  --expression-attribute-values '{":inc":{"N":"1"}}'
```

#### Step 5: Delete Items

```bash
# Delete single item
aws dynamodb delete-item \
  --table-name Users \
  --key '{"user_id":{"S":"user-125"}}'

# Delete multiple items in batch
aws dynamodb batch-write-item \
  --request-items '{
    "Users": [
      {
        "DeleteRequest": {
          "Key": {"user_id": {"S": "user-124"}}
        }
      },
      {
        "DeleteRequest": {
          "Key": {"user_id": {"S": "user-125"}}
        }
      }
    ]
  }'
```

