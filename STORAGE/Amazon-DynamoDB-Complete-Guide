  --table-name Users \
  --item '{
    "user_id": {"S": "user-temp-001"},
    "name": {"S": "Temporary User"},
    "email": {"S": "temp@example.com"},
    "expiration_time": {"N": "'$EXPIRATION_TIME'"}
  }'

# Item will be automatically deleted after expiration_time
```

