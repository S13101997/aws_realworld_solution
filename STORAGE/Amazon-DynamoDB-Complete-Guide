## Real-World Use Cases

### Use Case 1: User Sessions and Real-Time Activity

**Scenario:** Track active user sessions with quick lookups

```bash
# Create Sessions table
aws dynamodb create-table \
  --table-name Sessions \
  --attribute-definitions \
    AttributeName=session_id,AttributeType=S \
  --key-schema \
    AttributeName=session_id,KeyType=HASH \
  --billing-mode PAY_PER_REQUEST \
  --stream-specification StreamEnabled=true,StreamViewType=NEW_IMAGE

# Enable TTL for automatic session expiration
aws dynamodb update-time-to-live \
  --table-name Sessions \
  --time-to-live-specification AttributeName=expiration_time,Enabled=true

# Create session on login
EXPIRATION_TIME=$(date -d "+24 hours" +%s)
SESSION_ID=$(uuidgen)

aws dynamodb put-item \
  --table-name Sessions \
  --item '{
    "session_id": {"S": "'$SESSION_ID'"},
    "user_id": {"S": "user-123"},
    "ip_address": {"S": "192.168.1.1"},
    "user_agent": {"S": "Mozilla/5.0..."},
    "created_at": {"S": "'$(date -I'T')'"},
    "last_activity": {"S": "'$(date -I'T')'"},
    "expiration_time": {"N": "'$EXPIRATION_TIME'"}
  }'

# Update last activity
aws dynamodb update-item \
  --table-name Sessions \
  --key '{"session_id":{"S":"'$SESSION_ID'"}}' \
  --update-expression "SET last_activity = :now" \
  --expression-attribute-values '{":now":{"S":"'$(date -I'T')'"}}' 

# Automatically expires after 24 hours
```

### Use Case 2: Shopping Cart (Temporary Storage)

```bash
# Create Cart table
aws dynamodb create-table \
  --table-name ShoppingCarts \
  --attribute-definitions \
    AttributeName=user_id,AttributeType=S \
  --key-schema \
    AttributeName=user_id,KeyType=HASH \
  --billing-mode PAY_PER_REQUEST

# Enable TTL (expire cart after 7 days)
aws dynamodb update-time-to-live \
  --table-name ShoppingCarts \
  --time-to-live-specification AttributeName=expiration_time,Enabled=true

# Add item to cart
aws dynamodb update-item \
  --table-name ShoppingCarts \
  --key '{"user_id":{"S":"user-123"}}' \
  --update-expression "SET #items = list_append(if_not_exists(#items, :empty_list), :item), updated_at = :now" \
  --expression-attribute-names '{"#items":"items"}' \
  --expression-attribute-values '{
    ":empty_list": {"L": []},
    ":item": {"L": [{"M": {
      "product_id": {"S": "prod-001"},
      "quantity": {"N": "2"},
      "price": {"N": "29.99"}
    }}]},
    ":now": {"S": "'$(date -I'T')'"}'
```

