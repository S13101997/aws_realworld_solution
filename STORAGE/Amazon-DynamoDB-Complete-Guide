    "player_name": {"S": "John"},
    "timestamp": {"S": "'$(date -I'T')'"}'
  }'

# Get top 10 scores for a game
aws dynamodb query \
  --table-name GameScores \
  --index-name GameScoresIndex \
  --key-condition-expression "game_id = :gid" \
  --expression-attribute-values '{":gid":{"S":"game-001"}}' \
  --scan-index-forward false \
  --limit 10
```

### Use Case 4: Analytics/Event Logging

```bash
# Create Events table with large-scale event logging
aws dynamodb create-table \
  --table-name Events \
  --attribute-definitions \
    AttributeName=event_type,AttributeType=S \
    AttributeName=timestamp,AttributeType=S \
  --key-schema \
    AttributeName=event_type,KeyType=HASH \
    AttributeName=timestamp,KeyType=RANGE \
  --billing-mode PAY_PER_REQUEST

# Enable TTL to auto-delete old events after 90 days
aws dynamodb update-time-to-live \
  --table-name Events \
  --time-to-live-specification AttributeName=expiration_time,Enabled=true

# Log event
aws dynamodb put-item \
  --table-name Events \
  --item '{
    "event_type": {"S": "user_login"},
    "timestamp": {"S": "'$(date -I'T')'" },
    "user_id": {"S": "user-123"},
    "ip_address": {"S": "192.168.1.1"},
    "event_data": {"M": {
      "browser": {"S": "Chrome"},
      "os": {"S": "Linux"},
      "device": {"S": "Desktop"}
    }},
    "expiration_time": {"N": "'$(date -d '+90 days' +%s)'"}
  }'
