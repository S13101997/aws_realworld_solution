## Real-World Use Cases

### Use Case 1: Healthcare Compliance (HIPAA)

**Scenario:** Healthcare app requires 7-year data retention with immutable backups

```bash
# Create compliance vault with lock
aws backup create-backup-vault \
  --backup-vault-name hipaa-vault \
  --encryption-key-arn arn:aws:kms:us-east-1:123456789012:key/xxxx

# Enable compliance lock (7 years = 2555 days)
aws put-backup-vault-lock-configuration \
  --backup-vault-name hipaa-vault \
  --min-retention-days 2555 \
  --max-retention-days 2555 \
  --changeable-for-days 0  # No grace period (strict compliance)

# Create backup plan with HIPAA requirements
aws backup create-backup-plan \
  --backup-plan '{
    "BackupPlanName": "HIPAACompliance",
    "Rules": [
      {
        "RuleName": "DailyHIPAABackup",
        "TargetBackupVaultName": "hipaa-vault",
        "ScheduleExpression": "cron(0 1 ? * * *)",
        "Lifecycle": {
          "DeleteAfterDays": 2555,
          "MoveToColdStorageAfterDays": 30
        },
        "RecoveryPointTags": {
          "Compliance": "HIPAA",
          "DataClassification": "PHI"
        }
      }
    ]
  }'

# Backup all RDS databases with patient data
aws backup create-backup-selection \
  --backup-plan-id hipaa-plan-id \
  --backup-selection '{
    "SelectionName": "PatientData",
    "Type": "RESOURCES",
    "Resources": ["*"],
    "ListOfTags": [
      {
        "ConditionType": "StringEquals",
        "ConditionKey": "data-type",
        "ConditionValue": "patient-records"
      }
    ]
  }'

# Audit compliance
aws backup list-backup-jobs \
  --query 'BackupJobs[?State==`COMPLETED`].[ResourceArn,CreationDate,Status]'
```

### Use Case 2: Disaster Recovery (Multi-Region)

**Scenario:** Critical database needs rapid disaster recovery in different region

```bash
# Create backup vault in primary region
aws backup create-backup-vault \
  --backup-vault-name prod-us-east-1

# Create backup vault in DR region
aws backup create-backup-vault \
  --backup-vault-name prod-us-west-2 \
  --region us-west-2

# Create backup plan with cross-region copy
aws backup create-backup-plan \
  --backup-plan '{
    "BackupPlanName": "DisasterRecovery",
    "Rules": [
      {
        "RuleName": "Hourly",
        "TargetBackupVaultName": "prod-us-east-1",
        "ScheduleExpression": "cron(0 * ? * * *)",
        "StartWindowMinutes": 60,
        "CompletionWindowMinutes": 120,
        "Lifecycle": {
          "DeleteAfterDays": 7
        },
        "CopyActions": [
          {
            "DestinationVaultArn": "arn:aws:backup:us-west-2:123456789012:backup-vault:prod-us-west-2",
            "Lifecycle": {
              "DeleteAfterDays": 7
            }
          }
        ]
      }
    ]
  }'

# Recovery: Start restore from DR region backup
aws backup start-restore-job \
  --recovery-point-arn arn:aws:backup:us-west-2:123456789012:recovery-point:rds-db-abc123 \
  --iam-role-arn arn:aws:iam::123456789012:role/AWSBackupRole \
  --metadata '{
    "DBInstanceIdentifier": "recovered-prod-db",
    "availabilityZone": "us-west-2a"
  }' \
  --region us-west-2
```

