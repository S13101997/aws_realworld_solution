## Step-by-Step Examples

### Example 1: Create RDS Backup Plan

#### Step 1: Create Backup Vault

```bash
# Create vault for RDS backups
aws backup create-backup-vault \
  --backup-vault-name rds-prod-vault \
  --backup-vault-description "Production RDS backups" \
  --tags Environment=Production,Application=Database

# Enable vault lock for compliance (optional)
aws put-backup-vault-lock-configuration \
  --backup-vault-name rds-prod-vault \
  --min-retention-days 30 \
  --max-retention-days 365 \
  --changeable-for-days 7
```

#### Step 2: Create Backup Plan

```bash
# Create backup plan JSON
cat > rds-backup-plan.json << 'EOF'
{
  "BackupPlanName": "RDSProduction",
  "BackupPlanDescription": "Daily RDS backups with cross-region copy",
  "Rules": [
    {
      "RuleName": "DailyBackup",
      "TargetBackupVaultName": "rds-prod-vault",
      "ScheduleExpression": "cron(0 2 ? * * *)",
      "StartWindowMinutes": 60,
      "CompletionWindowMinutes": 120,
      "Lifecycle": {
        "DeleteAfterDays": 30,
        "MoveToColdStorageAfterDays": 7
      },
      "RecoveryPointTags": {
        "Type": "DailyBackup",
        "Environment": "Production"
      },
      "CopyActions": [
        {
          "DestinationVaultArn": "arn:aws:backup:us-west-2:123456789012:backup-vault:rds-dr-vault",
          "Lifecycle": {
            "DeleteAfterDays": 30
          }
        }
      ]
    },
    {
      "RuleName": "WeeklyBackup",
      "TargetBackupVaultName": "rds-prod-vault",
      "ScheduleExpression": "cron(0 3 ? * 1 *)",
      "Lifecycle": {
        "DeleteAfterDays": 90
      },
      "RecoveryPointTags": {
        "Type": "WeeklyBackup"
      }
    }
  ]
}
EOF

# Create the backup plan
BACKUP_PLAN_ID=$(aws backup create-backup-plan \
  --backup-plan file://rds-backup-plan.json \
  --query 'BackupPlanId' \
  --output text)

echo "Backup Plan ID: $BACKUP_PLAN_ID"
```

#### Step 3: Assign Resources to Plan

```bash
# Method 1: Assign by tag
aws backup create-backup-selection \
  --backup-plan-id $BACKUP_PLAN_ID \
  --backup-selection '{
    "SelectionName": "ProductionRDSByTag",
    "Description": "All RDS instances tagged as production",
    "Type": "RESOURCES",
    "Resources": ["*"],
    "ListOfTags": [
      {
        "ConditionType": "StringEquals",
        "ConditionKey": "backup-plan",
        "ConditionValue": "daily"
      },
      {
        "ConditionType": "StringEquals",
        "ConditionKey": "environment",
        "ConditionValue": "production"
      }
    ]
  }'

# Method 2: Assign specific RDS instances
aws backup create-backup-selection \
  --backup-plan-id $BACKUP_PLAN_ID \
  --backup-selection '{
    "SelectionName": "SpecificRDSInstances",
    "Description": "Specific production RDS instances",
    "Type": "RESOURCES",
    "Resources": [
      "arn:aws:rds:us-east-1:123456789012:db:production-mysql",
      "arn:aws:rds:us-east-1:123456789012:db:production-postgres"
    ]
  }'
```

#### Step 4: Monitor Backup Jobs

```bash
# List backup jobs
aws backup list-backup-jobs \
  --by-account-id 123456789012 \
  --by-state COMPLETED

# List recovery points for specific DB
aws backup list-recovery-points-by-backup-vault \
  --backup-vault-name rds-prod-vault \
  --by-resource-type RDS \
  --query 'RecoveryPoints[*].[RecoveryPointArn,CreationDate,Status]' \
  --output table

# Get backup job details
aws backup describe-backup-job \
  --backup-job-id backup-job-12345678-1234-1234-1234-123456789012
```

#### Step 5: Restore from Backup

```bash
# Start restore job
RESTORE_JOB_ID=$(aws backup start-restore-job \
  --recovery-point-arn arn:aws:backup:us-east-1:123456789012:recovery-point:rds-db-abc123 \
  --iam-role-arn arn:aws:iam::123456789012:role/AWSBackupRole \
  --metadata '{
    "DBInstanceIdentifier": "restored-production-mysql",
    "availabilityZone": "us-east-1a",
    "port": "3306"
  }' \
  --query 'RestoreJobId' \
  --output text)

echo "Restore Job ID: $RESTORE_JOB_ID"

# Monitor restore progress
aws backup describe-restore-job \
  --restore-job-id $RESTORE_JOB_ID

# Wait for restoration complete
while true; do
  STATUS=$(aws backup describe-restore-job \
    --restore-job-id $RESTORE_JOB_ID \
    --query 'RestoreJob.Status' \
    --output text)
  
  if [ "$STATUS" == "COMPLETED" ]; then
    echo "Restore completed successfully"
    break
  elif [ "$STATUS" == "FAILED" ]; then
    echo "Restore failed"
    break
  else
    echo "Restore in progress: $STATUS"
    sleep 30
  fi
done
```

