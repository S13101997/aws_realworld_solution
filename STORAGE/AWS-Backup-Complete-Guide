# Enable governance lock for audit trail
aws put-backup-vault-lock-configuration \
  --backup-vault-name audit-vault \
  --min-retention-days 2555 \
  --max-retention-days 2555

# Create backup plan with audit trail
aws backup create-backup-plan \
  --backup-plan '{
    "BackupPlanName": "FinancialAudit",
    "Rules": [
      {
        "RuleName": "TwiceDaily",
        "TargetBackupVaultName": "audit-vault",
        "ScheduleExpression": "cron(0 6,18 ? * * *)",
        "Lifecycle": {
          "DeleteAfterDays": 2555
        },
        "RecoveryPointTags": {
          "AuditRequired": "true",
          "Compliance": "SOX"
        }
      }
    ]
  }'

# Monitor backup audit trail
aws backup list-backup-jobs \
  --query 'BackupJobs[*].[BackupJobId,ResourceArn,CreationDate,State]' \
  --output json > backup-audit-trail.json

# Export to CloudWatch Logs for archival
aws logs create-log-group --log-group-name /aws/backup/audit

aws backup list-backup-jobs \
  --query 'BackupJobs[*].[BackupJobId,ResourceArn,CreationDate]' \
  --output json | \
  aws logs put-log-events \
    --log-group-name /aws/backup/audit \
    --log-stream-name backup-trail
```

### Use Case 4: Development/Test Environment Management

**Scenario:** Refresh dev/test databases with production data daily

