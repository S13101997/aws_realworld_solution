## Cross-Account Backups

### 1. Cross-Account Backup Setup

```bash
# In primary account: Create backup vault
aws backup create-backup-vault \
  --backup-vault-name cross-account-vault \
  --backup-vault-description "Receives backups from other accounts"

# Enable cross-account access
aws backup put-backup-vault-access-policy \
  --backup-vault-name cross-account-vault \
  --policy '{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": [
            "arn:aws:iam::111111111111:root",
            "arn:aws:iam::222222222222:root"
          ]
        },
        "Action": [
          "backup:CopyIntoBackupVault",
          "backup:StartRestoreJob"
        ],
        "Resource": "*"
      }
    ]
  }'

# In secondary account: Create backup plan that copies to primary account vault
aws backup create-backup-plan \
  --backup-plan '{
    "BackupPlanName": "CrossAccountBackup",
    "Rules": [
      {
        "RuleName": "CopyToPrimaryAccount",
        "TargetBackupVaultName": "secondary-vault",
        "ScheduleExpression": "cron(0 5 ? * * *)",
        "CopyActions": [
          {
            "DestinationVaultArn": "arn:aws:backup:us-east-1:999999999999:backup-vault:cross-account-vault",
            "Lifecycle": {
              "DeleteAfterDays": 90
            }
          }
        ]
      }
    ]
  }'
```

