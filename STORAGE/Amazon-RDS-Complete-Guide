### Example 3: Create Snapshot and Restore

```bash
# Create manual snapshot
aws rds create-db-snapshot \
  --db-snapshot-identifier myapp-db-snapshot-2025-11-25 \
  --db-instance-identifier myapp-db

# Monitor snapshot creation
aws rds describe-db-snapshots \
  --db-snapshot-identifier myapp-db-snapshot-2025-11-25 \
  --query 'DBSnapshots[0].[DBSnapshotStatus,PercentProgress]'

# Wait for snapshot to complete
aws rds wait db-snapshot-available \
  --db-snapshot-identifier myapp-db-snapshot-2025-11-25

# Restore from snapshot to new instance
aws rds restore-db-instance-from-db-snapshot \
  --db-instance-identifier myapp-db-restored \
  --db-snapshot-identifier myapp-db-snapshot-2025-11-25 \
  --db-instance-class db.t3.small

# Wait for restore to complete
aws rds wait db-instance-available \
  --db-instance-identifier myapp-db-restored

# Connect to restored instance
mysql -h myapp-db-restored.c9akciq32.us-east-1.rds.amazonaws.com \
      -u admin -p
```

