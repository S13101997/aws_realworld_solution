### Example 5: Set Up Parameter Groups

```bash
# Create custom parameter group
aws rds create-db-parameter-group \
  --db-parameter-group-name mysql80-custom \
  --db-parameter-group-family mysql8.0 \
  --description "Custom MySQL 8.0 parameters"

# Modify parameters
aws rds modify-db-parameter-group \
  --db-parameter-group-name mysql80-custom \
  --parameters \
    ParameterName=max_connections,ParameterValue=200,ApplyMethod=immediate \
    ParameterName=slow_query_log,ParameterValue=1,ApplyMethod=immediate \
    ParameterName=long_query_time,ParameterValue=2,ApplyMethod=immediate

# Associate parameter group with instance
aws rds modify-db-instance \
  --db-instance-identifier myapp-db \
  --db-parameter-group-name mysql80-custom \
  --apply-immediately
```

